
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getRole() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
        return isSignedIn() && getRole() == 'admin';
    }

    function isGroupActiveAndMember(groupId) {
      let group = get(/databases/$(database)/documents/groups/$(groupId));
      return group.data.archivedAt == null && group.data.memberIds.hasAny([request.auth.uid]);
    }
    
    function isCreator(groupId) {
    	return get(/databases/$(database)/documents/groups/$(groupId)).data.createdById == request.auth.uid;
    }

    // --- Collections ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isUser(userId);
      allow update: if isUser(userId);
      allow delete: if false; 
    }
    
    match /groups/{groupId} {
        allow read: if (isGroupActiveAndMember(groupId)) || isAdmin();
        allow create: if isSignedIn();
        // Only creator/admin can change name/desc/archive. Any active member can add members.
        allow update: if isAdmin() || isCreator(groupId) || 
                      (isGroupActiveAndMember(groupId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']));
        allow delete: if isAdmin();
    }

    match /expenses/{expenseId} {
        allow read, delete: if isGroupActiveAndMember(resource.data.groupId) || isAdmin();
        allow create, update: if isGroupActiveAndMember(request.resource.data.groupId) || isAdmin();
    }
    
    match /settlements/{settlementId} {
        allow read, delete: if isGroupActiveAndMember(resource.data.groupId) || isAdmin();
        allow create, update: if isGroupActiveAndMember(request.resource.data.groupId) || isAdmin();
    }

    match /history/{historyId} {
        allow read: if isGroupActiveAndMember(resource.data.groupId) || isAdmin();
        allow create: if isSignedIn();
        allow update: if (isGroupActiveAndMember(request.resource.data.groupId) || isAdmin())
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['restored']);
        allow delete: if isAdmin();
    }
    
    match /settings/{docId} {
        allow read: if true; 
        allow write: if isAdmin();
    }
    
    // Rules for 'tickets' collection
    match /tickets/{ticketId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isUser(resource.data.userId) || isAdmin();
      // Allow user to add messages, or admin to do anything
      allow update: if (isUser(resource.data.userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages', 'updatedAt', 'status'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Rules for 'notifications' collection
    match /notifications/{notificationId} {
      // Any signed-in user can read announcements
      allow read: if isSignedIn();
      // Only admins can create notifications
      allow create: if isAdmin();
      // Users can update a notification only to add themselves to the 'readBy' array
      allow update: if isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
                    && request.resource.data.readBy == resource.data.readBy.concat([request.auth.uid]);
      // Only admins can delete notifications
      allow delete: if isAdmin();
    }
  }
}
