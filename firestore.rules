
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
        return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isGroupActiveAndMember(groupId) {
      let group = get(/databases/$(database)/documents/groups/$(groupId));
      // Check for existence of archivedAt before comparing to null
      return ('archivedAt' in group.data && group.data.archivedAt == null) && 
             (request.auth.uid in group.data.memberIds);
    }
    
    function isCreator(groupId) {
    	return get(/databases/$(database)/documents/groups/$(groupId)).data.createdById == request.auth.uid;
    }

    // --- Collections ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isUser(userId);
      allow update: if isUser(userId) || isAdmin();
      allow delete: if false; 
    }
    
    match /groups/{groupId} {
        allow read, write: if isAdmin(); // Admins can do anything
        
        allow get: if isGroupActiveAndMember(groupId);
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberIds;
        allow create: if isSignedIn();
        allow update: if isCreator(groupId) || 
                      (isGroupActiveAndMember(groupId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']));
    }

    match /expenses/{expenseId} {
        allow read, write: if isAdmin(); // Admins can do anything

        allow get, delete: if isGroupActiveAndMember(resource.data.groupId);
        allow list: if isSignedIn() && request.auth.uid in resource.data.groupMemberIds;
        allow create, update: if isGroupActiveAndMember(request.resource.data.groupId);
    }
    
    match /settlements/{settlementId} {
        allow read, write: if isAdmin(); // Admins can do anything

        allow get, delete: if isGroupActiveAndMember(resource.data.groupId);
        allow list: if isSignedIn() && request.auth.uid in resource.data.groupMemberIds;
        allow create, update: if isGroupActiveAndMember(request.resource.data.groupId);
    }

    match /history/{historyId} {
        allow read, delete: if isAdmin();

        allow get: if isGroupActiveAndMember(resource.data.groupId);
        allow list: if isSignedIn() && request.auth.uid in resource.data.groupMemberIds;
        allow create: if isSignedIn();
        allow update: if (isGroupActiveAndMember(request.resource.data.groupId))
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['restored']);
    }
    
    match /settings/{docId} {
        allow read: if true; 
        allow write: if isAdmin();
    }
    
    // Rules for 'tickets' collection
    match /tickets/{ticketId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isUser(resource.data.userId) || isAdmin();
      // Allow user to add messages, or admin to do anything
      allow update: if (isUser(resource.data.userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages', 'updatedAt', 'status'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Rules for 'notifications' collection
    match /notifications/{notificationId} {
      // Any signed-in user can read announcements
      allow read: if isSignedIn();
      // Only admins can create notifications
      allow create: if isAdmin();
      // Users can update a notification only to add themselves to the 'readBy' array
      allow update: if isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
                    && request.resource.data.readBy == resource.data.readBy.concat([request.auth.uid]);
      // Only admins can delete notifications
      allow delete: if isAdmin();
    }
  }
}
