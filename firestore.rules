
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == userId;
    }
    
    match /groups/{groupId} {
    	allow read: if request.auth != null && resource.data.memberIds.hasAny([request.auth.uid]);
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.memberIds.hasAny([request.auth.uid]);
    }
    
    match /expenses/{expenseId} {
      allow read, write: if request.auth != null && get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.memberIds.hasAny([request.auth.uid]);
    }

    match /settlements/{settlementId} {
       allow read, write: if request.auth != null && get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.memberIds.hasAny([request.auth.uid]);
    }
    
    match /history/{historyId} {
    	allow read: if request.auth != null && resource.data.groupMemberIds.hasAny([request.auth.uid]);
      allow create: if request.auth != null;
    }
    
    match /settings/general {
    	allow read, write;
    }

    match /tickets/{ticketId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
