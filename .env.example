# ==============================================================================
# SplitIt — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env.local` or `.env` and fill in your values:
#   cp .env.example .env.local
# ==============================================================================

# ─── 1. APPLICATION BASE CONFIGURATION ───────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL="http://localhost:3231"
BETTER_AUTH_URL="http://localhost:3231"

# ─── 2. AUTHENTICATION (BETTER AUTH & GOOGLE OAUTH) ──────────────────────────
# Generate a secure 32-byte secret (e.g. `openssl rand -hex 32`):
BETTER_AUTH_SECRET="your_better_auth_secret_32_characters_minimum"

# Google OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Initial Bootstrap Administrator Email (granted Admin privileges upon first login)
ADMIN_EMAIL="admin@yourdomain.com"

# ─── 3. DATABASE (ORACLE AUTONOMOUS CLOUD DATABASE) ──────────────────────────
# Directory containing the downloaded Oracle Client Wallet (cwallet.sso, tnsnames.ora, etc.)
ORA_WALLET_DIR="./wallet"
ORA_DB_USER="ADMIN"
ORA_DB_PASSWORD="your_oracle_db_password"
# Service name defined in your tnsnames.ora (e.g. splititdb_high, splititdb_medium, splititdb_low)
ORA_CONNECT_STRING="splititdb_high"

# ─── 4. PUSH NOTIFICATIONS (VAPID / WEB PUSH) ────────────────────────────────
# Generate VAPID keypair using `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your_public_vapid_key"
VAPID_PRIVATE_KEY="your_private_vapid_key"
VAPID_EMAIL="mailto:admin@yourdomain.com"

# ─── 5. CLOUD OBJECT STORAGE (OCI S3-COMPATIBLE API) ─────────────────────────
# Oracle Cloud Infrastructure Object Storage credentials for avatars, receipts, and attachments
OCI_REGION="ap-mumbai-1"
OCI_NAMESPACE="your_tenancy_namespace"
OCI_STORAGE_BUCKET="splitit-storage"
OCI_STORAGE_ENDPOINT="https://your_tenancy_namespace.compat.objectstorage.ap-mumbai-1.oraclecloud.com"
OCI_S3_ACCESS_KEY="your_oci_customer_secret_access_key_id"
OCI_S3_SECRET_KEY="your_oci_customer_secret_key"

# ─── 6. INTERNAL API CRON / BACKGROUND WORKER SECURITY ───────────────────────
# Shared secret for authenticating automated cron triggers (e.g. `/api/reminders/trigger`)
INTERNAL_API_SECRET="your_internal_api_secret_for_cron_jobs"
